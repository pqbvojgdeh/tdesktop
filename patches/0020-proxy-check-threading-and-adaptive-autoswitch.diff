+/*
+This file is part of Telegram Desktop,
+the official desktop application for the Telegram messaging service.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#pragma once
+
+#include <algorithm>
+#include <cstdlib>
+
+namespace Core::details {
+
+inline constexpr auto kProxyRotationSelectionPollMs = 100;
+inline constexpr auto kProxyRotationSelectionMaximumWaitMs = 2500;
+inline constexpr auto kProxyRotationFailurePenaltyStep = 250;
+inline constexpr auto kProxyRotationMaximumFailurePenalty = 2000;
+
+struct ProxyRotationHealth final {
+	int smoothedPing = 0;
+	int deviation = 0;
+	int failurePenalty = 0;
+};
+
+[[nodiscard]] constexpr ProxyRotationHealth ProxyRotationRecordSuccess(
+		ProxyRotationHealth health,
+		int ping) {
+	ping = std::max(ping, 1);
+	if (!health.smoothedPing) {
+		health.smoothedPing = ping;
+		health.deviation = 0;
+	} else {
+		const auto delta = std::abs(ping - health.smoothedPing);
+		health.deviation = (3 * health.deviation + delta) / 4;
+		health.smoothedPing = (3 * health.smoothedPing + ping) / 4;
+	}
+	health.failurePenalty /= 2;
+	return health;
+}
+
+[[nodiscard]] constexpr ProxyRotationHealth ProxyRotationRecordFailure(
+		ProxyRotationHealth health) {
+	health.failurePenalty = std::min(
+		health.failurePenalty + kProxyRotationFailurePenaltyStep,
+		kProxyRotationMaximumFailurePenalty);
+	health.deviation = std::min(health.deviation + 50, 1000);
+	return health;
+}
+
+[[nodiscard]] constexpr int ProxyRotationSelectionScore(
+		const ProxyRotationHealth &health,
+		int ping,
+		int ageSeconds) {
+	const auto normalizedPing = std::max(ping, 1);
+	const auto agePenalty = std::clamp(ageSeconds * 5, 0, 100);
+	return normalizedPing
+		+ health.failurePenalty
+		+ (health.deviation / 2)
+		+ agePenalty;
+}
+
+[[nodiscard]] constexpr bool ProxyRotationShouldKeepWaiting(
+		bool hasPendingChecks,
+		int elapsedMs) {
+	return hasPendingChecks
+		&& elapsedMs < kProxyRotationSelectionMaximumWaitMs;
+}
+
+static_assert(kProxyRotationSelectionPollMs > 0);
+static_assert(
+	kProxyRotationSelectionPollMs < kProxyRotationSelectionMaximumWaitMs);
+
+} // namespace Core::details
