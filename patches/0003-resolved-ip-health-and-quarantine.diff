+#pragma once
+
+namespace MTP::details {
+
+// Values intentionally match QAbstractSocket::SocketError. Keeping the
+// policy independent from Qt makes it usable in the lightweight policy test.
+inline constexpr auto kSocketConnectionRefusedError = 0;
+inline constexpr auto kSocketRemoteHostClosedError = 1;
+inline constexpr auto kSocketTimeoutError = 5;
+inline constexpr auto kSocketProxyConnectionRefusedError = 14;
+inline constexpr auto kSocketProxyConnectionClosedError = 15;
+inline constexpr auto kSocketProxyConnectionTimeoutError = 16;
+
+enum class ResolvedIpFailureOrigin {
+	ChildError,
+	ConnectTimeout,
+	ExternalTimeout,
+	EarlyDisconnect,
+};
+
+[[nodiscard]] constexpr bool IsEndpointLocalSocketError(int errorCode) {
+	switch (errorCode) {
+	case kSocketConnectionRefusedError:
+	case kSocketRemoteHostClosedError:
+	case kSocketTimeoutError:
+	case kSocketProxyConnectionRefusedError:
+	case kSocketProxyConnectionClosedError:
+	case kSocketProxyConnectionTimeoutError:
+		return true;
+	default:
+		return false;
+	}
+}
+
+[[nodiscard]] constexpr bool ShouldQuarantineResolvedIp(
+		ResolvedIpFailureOrigin origin,
+		int errorCode = -1) {
+	switch (origin) {
+	case ResolvedIpFailureOrigin::ConnectTimeout:
+	case ResolvedIpFailureOrigin::ExternalTimeout:
+	case ResolvedIpFailureOrigin::EarlyDisconnect:
+		return true;
+	case ResolvedIpFailureOrigin::ChildError:
+		return IsEndpointLocalSocketError(errorCode);
+	}
+	return false;
+}
+
+} // namespace MTP::details
