diff --git a/Telegram/CMakeLists.txt b/Telegram/CMakeLists.txt
index b695d6b..8592879 100644
--- a/Telegram/CMakeLists.txt
+++ b/Telegram/CMakeLists.txt
@@ -90,6 +90,20 @@ PRIVATE
     desktop-app::external_xxhash
 )
 
+if (DESKTOP_APP_MTPROTO_PROFILE_TESTS)
+    # The definition goes to td_mtproto only, where the validator itself is
+    # compiled. Telegram receives the entry point as one extra source file
+    # instead of a target-wide definition, so turning the option off for the
+    # packaged binary changes the source list rather than the compile flags:
+    # the relink then recompiles a few dozen files instead of the whole app.
+    target_compile_definitions(td_mtproto PRIVATE
+        DESKTOP_APP_MTPROTO_PROFILE_TESTS
+    )
+    target_sources(Telegram PRIVATE
+        ${src_loc}/mtproto_profile_test_entry.cpp
+    )
+endif()
+
 if (NOT DESKTOP_APP_DISABLE_SWIFT6)
     telegram_add_apple_swift_runtime(Telegram)
 endif()
diff --git a/Telegram/SourceFiles/main.cpp b/Telegram/SourceFiles/main.cpp
index d3d938c..5980227 100644
--- a/Telegram/SourceFiles/main.cpp
+++ b/Telegram/SourceFiles/main.cpp
@@ -7,7 +7,26 @@ https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "core/launcher.h"
 
+namespace Core {
+
+// Installed by mtproto_profile_test_entry.cpp, which is added to the target
+// only in a DESKTOP_APP_MTPROTO_PROFILE_TESTS build. It stays null in the
+// shipping build, where that translation unit is not compiled at all, so the
+// two configurations differ by one source file instead of by a preprocessor
+// definition on the whole target. Constant initialization runs before any
+// dynamic initializer, so the installer in the other unit cannot race it.
+int (*OptionalTestEntryPoint)(int argc, char *argv[]) = nullptr;
+
+} // namespace Core
+
 int main(int argc, char *argv[]) {
+	if (Core::OptionalTestEntryPoint) {
+		// A negative result means these are not the test arguments.
+		const auto code = Core::OptionalTestEntryPoint(argc, argv);
+		if (code >= 0) {
+			return code;
+		}
+	}
 	const auto launcher = Core::Launcher::Create(argc, argv);
 	return launcher ? launcher->exec() : 1;
 }
diff --git a/Telegram/SourceFiles/mtproto_profile_test_entry.cpp b/Telegram/SourceFiles/mtproto_profile_test_entry.cpp
