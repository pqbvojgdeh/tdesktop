+
+struct SlowConnectSlot {
+	sc::steady_clock::time_point next;
+	int pending = 0;
+};
+
+[[nodiscard]] QMutex &SlowConnectMutex() {
+	static auto result = new QMutex();
+	return *result;
+}
+
+[[nodiscard]] std::map<SlowConnectEndpoint, SlowConnectSlot> &
+SlowConnectSlots() {
+	static auto result = new std::map<SlowConnectEndpoint, SlowConnectSlot>();
+	return *result;
+}
+
+class SlowConnectReservation final {
+public:
+	explicit SlowConnectReservation(SlowConnectEndpoint endpoint)
+	: _endpoint(std::move(endpoint)) {
+	}
+
+	~SlowConnectReservation() {
+		release();
+	}
+
+	void release() {
+		if (_released.exchange(true)) {
+			return;
+		}
+		const QMutexLocker lock(&SlowConnectMutex());
+		auto &slots = SlowConnectSlots();
+		if (const auto i = slots.find(_endpoint); i != end(slots)) {
+			i->second.pending = std::max(i->second.pending - 1, 0);
+			if (i->second.pending == 0
+				&& i->second.next <= sc::steady_clock::now()) {
+				slots.erase(i);
+			}
+		}
+	}
+
+private:
+	const SlowConnectEndpoint _endpoint;
+	std::atomic_bool _released = false;
+};
+
+struct SlowConnectSchedule {
+	sc::milliseconds waitFor{ 0 };
+	std::shared_ptr<SlowConnectReservation> reservation;
+	bool overflow = false;
+};
+
+[[nodiscard]] SlowConnectSchedule ReserveSlowConnect(
+		const SlowConnectEndpoint &endpoint,
+		int delay,
+		int jitter) {
+	auto result = SlowConnectSchedule();
+	const auto policy = NormalizeSlowConnectPolicy(delay, jitter);
+	delay = policy.delay;
+	jitter = policy.jitter;
+	const auto overflowDelay = [] {
+		return sc::milliseconds(NormalizeSlowConnectOverflowDelay(
+			QRandomGenerator::global()->bounded(
+				kSlowConnectOverflowMinimumDelayMs,
+				kSlowConnectOverflowMaximumDelayMs + 1)));
+	};
+	const QMutexLocker lock(&SlowConnectMutex());
+	auto &slots = SlowConnectSlots();
+	const auto now = sc::steady_clock::now();
+	for (auto i = slots.begin(); i != slots.end();) {
+		i = (i->second.pending == 0 && i->second.next <= now)
+			? slots.erase(i)
+			: std::next(i);
+	}
+	if (!slots.contains(endpoint)
+		&& slots.size() >= kSlowConnectMaximumSlots) {
+		const auto removable = std::min_element(
+			begin(slots),
+			end(slots),
+			[](const auto &a, const auto &b) {
+				if (a.second.pending != b.second.pending) {
+					return a.second.pending < b.second.pending;
+				}
+				return a.second.next < b.second.next;
+			});
+		if (removable == end(slots) || removable->second.pending != 0) {
+			result.overflow = true;
+			result.waitFor = overflowDelay();
+			return result;
+		}
+		slots.erase(removable);
+	}
+	const auto extra = jitter
+		? QRandomGenerator::global()->bounded(jitter + 1)
+		: 0;
+	const auto gap = std::min(
+		sc::milliseconds(delay + extra),
+		kMaximumDelayedConnect);
+	auto &slot = slots[endpoint];
+	if (slot.next.time_since_epoch().count() != 0) {
+		if (now < slot.next) {
+			result.waitFor = sc::duration_cast<sc::milliseconds>(
+				slot.next - now);
+		} else {
+			slot.next = now;
+		}
+	}
+	const auto maximum = now + kMaximumDelayedConnect;
+	const auto next = slot.next.time_since_epoch().count() == 0
+		? now + gap
+		: slot.next + gap;
+	result.overflow = (slot.pending >= kMaximumPendingDelayedConnects)
+		|| (next > maximum);
+	if (!result.overflow) {
+		slot.next = next;
+		if (result.waitFor.count() > 0) {
+			++slot.pending;
+			result.reservation = std::make_shared<SlowConnectReservation>(
+				endpoint);
+		}
+	} else {
+		// Do not turn local scheduler pressure into a simultaneous TCP burst.
+		result.waitFor = overflowDelay();
+	}
+	return result;
+}
