+constexpr auto kMaximumChromium150EndpointStates = 128;
+constexpr auto kChromium150TicketSlots = 2;
+auto Chromium150Resumption = MTP::details::ChromiumResumptionCache<
+	Chromium150EndpointKey>(
+		kMaximumChromium150EndpointStates,
+		kChromium150TicketSlots);
+
+[[nodiscard]] auto TakeChromium150Resumption(
+		const Chromium150EndpointKey &key) {
+	return Chromium150Resumption.takeWithRemaining(key);
+}
+
+void ConfirmClientHello(
+		const QString &address,
+		int port,
+		const QByteArray &domain,
+		ProxyData::CHelloType configured,
+		ProxyData::CHelloType actual,
+		bool resumed) {
+	auto ttlMinutes = 0;
+	if (actual == ProxyData::CHelloType::Chromium150) {
+		const auto key = Chromium150EndpointKey(address, port, domain);
+		ttlMinutes = int(Chromium150Resumption.confirm(key, [] {
+			return std::chrono::minutes(
+				30 + QRandomGenerator::global()->bounded(31));
+		}).count());
+	}
+
+	auto status = ProxyData::CHelloStatus();
+	status.configured = configured;
+	status.actual = actual;
+	status.host = address;
+	status.port = port;
+	status.domainId = ClientHelloDomainId(domain);
+	status.random = (configured == ProxyData::CHelloType::RANDOM);
+	status.chromium150 = (actual == ProxyData::CHelloType::Chromium150);
+	status.resumed = resumed;
+	status.ttlMinutes = ttlMinutes;
+	status.ttlLeftMinutes = ttlMinutes;
+	status.used = true;
+	ProxyData::setGlobalCHelloStatus(status);
+}
+
+[[nodiscard]] ProxyData::CHelloType StickyRandomClientHelloType() {
+	static const auto result = [] {
+		auto profiles = std::vector{
+			ProxyData::CHelloType::Firefox,
+			ProxyData::CHelloType::Chrome,
+			ProxyData::CHelloType::Custom,
+			ProxyData::CHelloType::Chromium150,
+		};
+		if constexpr (Platform::IsMac()) {
+			profiles.push_back(ProxyData::CHelloType::SafariMac);
+		}
+		if (QLocale::system().language() == QLocale::Russian) {
+			profiles.push_back(ProxyData::CHelloType::YandexGost);
+		}
+		Assert(!profiles.empty());
+		return profiles[QRandomGenerator::global()->bounded(
+			int(profiles.size()))];
+	}();
+	return result;
+}
+
+[[nodiscard]] ClientHelloSelection PrepareClientHelloRules(
+		const QString &address,
+		int port,
+		const QByteArray &domain) {
+	static MTPTlsClientHello chRules_chrome  = PrepareClientHelloRules_Chrome();
+	static MTPTlsClientHello chRules_firefox = PrepareClientHelloRules_Firefox();
+	static MTPTlsClientHello chRules_custom  = PrepareClientHelloRules_Firefox(true);
+	static MTPTlsClientHello chRules_safari  = PrepareClientHelloRules_SafariMac();
+	static MTPTlsClientHello chRules_yandex  = PrepareClientHelloRules_YandexGost();
+	static MTPTlsClientHello chRules_chromium150Fresh = PrepareClientHelloRules_Chromium150(false);
+	static MTPTlsClientHello chRules_chromium150Resumed = PrepareClientHelloRules_Chromium150(true);
+	const auto configured_ch_type = MTP::ProxyData::globalClientHelloRulesType();
+	auto ch_type = configured_ch_type;
+	if (ProxyData::CHelloType::RANDOM == ch_type) {
+		ch_type = StickyRandomClientHelloType();
+	}
+	const auto result = [&](
+			const MTPTlsClientHello &rules,
+			ProxyData::CHelloType actual,
+			bool resumed = false) {
+		return ClientHelloSelection{
+			.rules = &rules,
+			.configured = configured_ch_type,
+			.actual = actual,
+			.resumed = resumed,
+		};
+	};
+	switch(ch_type) {
+		case ProxyData::CHelloType::Chrome:
+			// qDebug(">>> using Chrome ClientHello");
+			return result(chRules_chrome, ch_type);
+		case ProxyData::CHelloType::Custom:
+			// qDebug(">>> using custom ClientHello");
+			return result(chRules_custom, ch_type);
+		case ProxyData::CHelloType::SafariMac:
+			return result(chRules_safari, ch_type);
+		case ProxyData::CHelloType::YandexGost:
+			return result(chRules_yandex, ch_type);
+		case ProxyData::CHelloType::Chromium150: {
+			const auto resumption = TakeChromium150Resumption(
+				Chromium150EndpointKey(address, port, domain));
+			if (resumption.taken) {
+				ProxyData::updateGlobalCHelloStatusLifetime(
+					address,
+					port,
+					ClientHelloDomainId(domain),
+					int(resumption.maximumRemaining.count()));
+			}
+			return result(
+				resumption.taken
+					? chRules_chromium150Resumed
+					: chRules_chromium150Fresh,
+				ch_type,
+				resumption.taken);
+		}
+		case ProxyData::CHelloType::Firefox:
+		default:
+			// qDebug(">>> using FireFox ClientHello");
+			return result(chRules_firefox, ProxyData::CHelloType::Firefox);
+	}
+}
