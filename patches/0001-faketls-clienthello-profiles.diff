+
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+#include <iterator>
+#include <map>
+#include <mutex>
+#include <utility>
+#include <vector>
+
+namespace MTP::details {
+
+template <typename Key>
+class ChromiumResumptionCache final {
+public:
+	using Clock = std::chrono::steady_clock;
+	using TimePoint = Clock::time_point;
+	using Lifetime = std::chrono::minutes;
+	struct TakeResult {
+		bool taken = false;
+		Lifetime maximumRemaining = Lifetime(0);
+	};
+
+	ChromiumResumptionCache(std::size_t maximumEntries, int resumptionSlots)
+	: _maximumEntries(maximumEntries)
+	, _resumptionSlots(std::max(resumptionSlots, 0)) {
+	}
+
+	[[nodiscard]] bool take(const Key &key, TimePoint now = Clock::now()) {
+		return takeWithRemaining(key, now).taken;
+	}
+
+	[[nodiscard]] TakeResult takeWithRemaining(
+			const Key &key,
+			TimePoint now = Clock::now()) {
+		const auto lock = std::lock_guard(_mutex);
+		prune(now);
+		const auto i = _entries.find(key);
+		if (i == end(_entries)) {
+			return {};
+		}
+		i->second.pop_back();
+		if (i->second.empty()) {
+			_entries.erase(i);
+			return { true, Lifetime(0) };
+		}
+		const auto expiry = *std::max_element(
+			begin(i->second),
+			end(i->second));
+		return {
+			true,
+			std::chrono::ceil<Lifetime>(expiry - now),
+		};
+	}
+
+	template <typename LifetimeGenerator>
+	[[nodiscard]] Lifetime confirm(
+			const Key &key,
+			LifetimeGenerator &&generateLifetime,
+			TimePoint now = Clock::now()) {
+		const auto lock = std::lock_guard(_mutex);
+		prune(now);
+		if (!_maximumEntries || !_resumptionSlots) {
+			return Lifetime(0);
+		}
+		if (!_entries.contains(key) && _entries.size() >= _maximumEntries) {
+			eraseEarliestExpiring();
+		}
+		auto slots = std::vector<TimePoint>();
+		slots.reserve(static_cast<std::size_t>(_resumptionSlots));
+		auto longest = Lifetime(0);
+		for (auto slot = 0; slot != _resumptionSlots; ++slot) {
+			const auto lifetime = std::max(
+				Lifetime(1),
+				Lifetime(generateLifetime()));
+			slots.push_back(now + lifetime);
+			longest = std::max(longest, lifetime);
+		}
+		_entries.insert_or_assign(key, std::move(slots));
+		return longest;
+	}
+
+	[[nodiscard]] std::size_t slotCount(
+			const Key &key,
+			TimePoint now = Clock::now()) {
+		const auto lock = std::lock_guard(_mutex);
+		prune(now);
+		const auto i = _entries.find(key);
+		return (i == end(_entries)) ? 0 : i->second.size();
+	}
+
+private:
+	using Slots = std::vector<TimePoint>;
+
+	void prune(TimePoint now) {
+		for (auto i = _entries.begin(); i != _entries.end();) {
+			auto &slots = i->second;
+			slots.erase(
+				std::remove_if(
+					begin(slots),
+					end(slots),
+					[=](TimePoint expiry) { return expiry <= now; }),
+				end(slots));
+			i = slots.empty() ? _entries.erase(i) : std::next(i);
+		}
+	}
+
+	void eraseEarliestExpiring() {
+		const auto maximumExpiry = [](const Slots &slots) {
+			return slots.empty()
+				? TimePoint::min()
+				: *std::max_element(begin(slots), end(slots));
+		};
+		const auto oldest = std::min_element(
+			begin(_entries),
+			end(_entries),
+			[&](const auto &a, const auto &b) {
+				return maximumExpiry(a.second) < maximumExpiry(b.second);
+			});
+		if (oldest != end(_entries)) {
+			_entries.erase(oldest);
+		}
+	}
+
+	const std::size_t _maximumEntries;
+	const int _resumptionSlots;
+	std::mutex _mutex;
+	std::map<Key, Slots> _entries;
+};
+
+} // namespace MTP::details
