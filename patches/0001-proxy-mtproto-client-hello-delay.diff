+			: u"%1:%2"_q.arg(address).arg(port);
+		status.random = (configured_ch_type == ProxyData::CHelloType::RANDOM);
+		status.chromium150 = (actual_ch_type == ProxyData::CHelloType::Chromium150);
+		status.resumed = resumed;
+		status.ttlMinutes = ttlMinutes;
+		status.ttlLeftMinutes = ttlLeftMinutes;
+		status.used = true;
+		MTP::ProxyData::setGlobalCHelloStatus(status);
+	};
+	switch(ch_type) {
+		case ProxyData::CHelloType::Chrome:
+			// qDebug(">>> using Chrome ClientHello");
+			saveStatus(ch_type);
+			return chRules_chrome;
+		case ProxyData::CHelloType::Custom:
+			// qDebug(">>> using custom ClientHello");
+			saveStatus(ch_type);
+			return chRules_custom;
+		case ProxyData::CHelloType::SafariMac:
+			saveStatus(ch_type);
+			return chRules_safari;
+		case ProxyData::CHelloType::YandexGost:
+			saveStatus(ch_type);
+			return chRules_yandex;
+		case ProxyData::CHelloType::Chromium150: {
+			int ttlMinutes = 0;
+			int ttlLeftMinutes = 0;
+			const auto resumed = [&] {
+				namespace sc = std::chrono;
+				const QMutexLocker lock(&chromium150Mutex);
+				const auto now = sc::steady_clock::now();
+				for (auto i = chromium150SeenByEndpoint.begin();
+						i != chromium150SeenByEndpoint.end();) {
+					const auto &old = i->second;
+					const auto expired = old.seenAt.time_since_epoch().count()
+						&& (now - old.seenAt >= old.ttl + sc::hours(1));
+					i = expired
+						? chromium150SeenByEndpoint.erase(i)
+						: std::next(i);
+				}
+				const auto key = std::pair(address, port);
+				if (!chromium150SeenByEndpoint.contains(key)
+					&& chromium150SeenByEndpoint.size()
+						>= kMaximumChromium150EndpointStates) {
+					const auto oldest = std::min_element(
+						begin(chromium150SeenByEndpoint),
+						end(chromium150SeenByEndpoint),
+						[](const auto &a, const auto &b) {
+							return a.second.seenAt < b.second.seenAt;
+						});
+					if (oldest != end(chromium150SeenByEndpoint)) {
+						chromium150SeenByEndpoint.erase(oldest);
+					}
+				}
+				auto &state = chromium150SeenByEndpoint[key];
+				const auto result = state.seenAt.time_since_epoch().count() != 0
+					&& now - state.seenAt < state.ttl;
+				if (!result) {
+					state.ttl = sc::minutes(30 + QRandomGenerator::global()->bounded(31));
+					state.seenAt = now;
+				}
+				ttlMinutes = int(state.ttl.count());
+				const auto elapsed = result
+					? int(sc::duration_cast<sc::minutes>(now - state.seenAt).count())
+					: 0;
+				ttlLeftMinutes = ttlMinutes - elapsed;
+				if (ttlLeftMinutes < 0) {
+					ttlLeftMinutes = 0;
+				}
