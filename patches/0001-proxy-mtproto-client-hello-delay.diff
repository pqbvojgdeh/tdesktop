+void ProxiesBoxController::refreshAllChecks() {
+	if (!_settings.isEnabled() || _checksRunning.current()) {
+		return;
+	}
+	_batchChecksLeft = ranges::count(_list, false, &Item::deleted);
+	_checksRunning = (_batchChecksLeft > 0);
+	if (!_batchChecksLeft) {
+		finishChecksBatch();
+		return;
+	}
+	for (auto &item : _list) {
+		if (!item.deleted) {
+			refreshChecker(item, true);
+		}
+	}
+}
+
+void ProxiesBoxController::cancelAllChecks() {
+	for (auto &item : _list) {
+		item.checker = nullptr;
+		item.batchCheck = false;
+		item.state = ItemState::Inactive;
+		item.ping = 0;
+		item.checkedAt = QString();
+		updateView(item);
+	}
+	sortListByEndpoint();
+	_batchChecksLeft = 0;
+	_checksRunning = false;
+	_checksFinished.fire({});
+}
+
+void ProxiesBoxController::finishChecksBatch() {
+	_batchChecksLeft = 0;
+	const auto rank = [&](const Item &item) {
+		switch (viewForItem(item).state) {
+		case ItemState::Online:
+		case ItemState::Available: return 0;
+		case ItemState::Connecting:
+		case ItemState::Checking:
+		case ItemState::Inactive: return 1;
+		case ItemState::Unavailable: return 2;
+		}
+		Unexpected("ItemState in ProxiesBoxController::finishChecksBatch.");
+	};
+	std::stable_sort(begin(_list), end(_list), [&](const Item &a, const Item &b) {
+		if (a.deleted != b.deleted) {
+			return !a.deleted;
+		}
+		const auto aRank = rank(a);
+		const auto bRank = rank(b);
+		if (aRank != bRank) {
+			return aRank < bRank;
+		}
+		if (aRank != 0) {
+			return compareEndpoints(a, b) < 0;
+		}
+		const auto aPing = a.ping > 0 ? a.ping : std::numeric_limits<int>::max();
+		const auto bPing = b.ping > 0 ? b.ping : std::numeric_limits<int>::max();
+		return (aPing != bPing)
+			? (aPing < bPing)
+			: (compareEndpoints(a, b) < 0);
+	});
