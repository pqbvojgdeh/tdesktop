+using Chromium150EndpointKey = std::tuple<QString, int, QByteArray>;
+
+[[nodiscard]] QByteArray ClientHelloDomainId(const QByteArray &domain) {
+	const auto hash = openssl::Sha256(bytes::make_span(domain));
+	return QByteArray(
+		reinterpret_cast<const char*>(hash.data()),
+		int(hash.size()));
