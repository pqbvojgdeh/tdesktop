+void ProxiesBoxController::finishChecksBatch() {
+	_batchChecksLeft = 0;
+	std::stable_sort(begin(_list), end(_list), [](const Item &a, const Item &b) {
+		if (a.deleted != b.deleted) {
+			return !a.deleted;
+		}
+		const auto aUnavailable = (a.state == ItemState::Unavailable);
+		const auto bUnavailable = (b.state == ItemState::Unavailable);
+		if (aUnavailable != bUnavailable) {
+			return !aUnavailable;
+		}
+		if (aUnavailable) {
+			return false;
+		}
+		return a.ping < b.ping;
+	});
+	_checksRunning = false;
+	_checksFinished.fire({});
+}
