+[[nodiscard]] QString ClientHelloName(ProxyData::CHelloType type) {
+	switch (type) {
+	case ProxyData::CHelloType::Chrome:
+		return u"Chrome"_q;
+	case ProxyData::CHelloType::Custom:
+		return u"Firefox (permuted ext)"_q;
+	case ProxyData::CHelloType::SafariMac:
+		return u"Safari (macOS)"_q;
+	case ProxyData::CHelloType::YandexGost:
+		return u"Yandex (GOST)"_q;
+	case ProxyData::CHelloType::Chromium150:
+		return u"Chromium 150"_q;
+	case ProxyData::CHelloType::RANDOM:
+		return u"Random"_q;
+	case ProxyData::CHelloType::Firefox:
+	default:
+		return u"FireFox"_q;
+	}
+}
+
+[[nodiscard]] QString ClientHelloStatusText() {
+	const auto status = ProxyData::globalCHelloStatus();
+	if (!status.used) {
+		return u"Last ClientHello: not used yet"_q;
+	}
+	auto result = u"Last ClientHello: "_q;
+	if (status.random) {
+		result += u"Random -> "_q;
+	}
+	result += ClientHelloName(status.actual);
+	if (status.chromium150) {
+		result += status.resumed ? u" resumed"_q : u" fresh"_q;
+		if (status.ttlMinutes > 0) {
+			result += status.resumed
+				? u", TTL left ~%1 min"_q.arg(status.ttlLeftMinutes)
+				: u", resumed window %1 min"_q.arg(status.ttlMinutes);
+		}
+	}
+	if (!status.endpoint.isEmpty()) {
+		result += u" ("_q + status.endpoint + u")"_q;
+	}
+	return result;
+}
