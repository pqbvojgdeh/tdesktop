+[[nodiscard]] ClientHelloSelection PrepareClientHelloRules(
+		const QString &address,
+		int port,
+		const QByteArray &domain) {
+	static MTPTlsClientHello chRules_chrome  = PrepareClientHelloRules_Chrome();
+	static MTPTlsClientHello chRules_firefox = PrepareClientHelloRules_Firefox();
+	static MTPTlsClientHello chRules_custom  = PrepareClientHelloRules_Firefox(true);
+	static MTPTlsClientHello chRules_safari  = PrepareClientHelloRules_SafariMac();
+	static MTPTlsClientHello chRules_yandex  = PrepareClientHelloRules_YandexGost();
+	static MTPTlsClientHello chRules_chromium150Fresh = PrepareClientHelloRules_Chromium150(false);
+	static MTPTlsClientHello chRules_chromium150Resumed = PrepareClientHelloRules_Chromium150(true);
+	const auto configured_ch_type = MTP::ProxyData::globalClientHelloRulesType();
+	auto ch_type = configured_ch_type;
+	if (ProxyData::CHelloType::RANDOM == ch_type) {
+		constexpr auto kRandomProfiles = std::array{
+			ProxyData::CHelloType::Firefox,
+			ProxyData::CHelloType::Chrome,
+			ProxyData::CHelloType::Custom,
+			ProxyData::CHelloType::SafariMac,
+			ProxyData::CHelloType::YandexGost,
+			ProxyData::CHelloType::Chromium150,
+		};
+		ch_type = kRandomProfiles[QRandomGenerator::global()->bounded(
+			int(kRandomProfiles.size()))];
+	}
+	const auto result = [&](
+			const MTPTlsClientHello &rules,
+			ProxyData::CHelloType actual,
+			bool resumed = false) {
+		return ClientHelloSelection{
+			.rules = &rules,
+			.configured = configured_ch_type,
+			.actual = actual,
+			.resumed = resumed,
+		};
+	};
+	switch(ch_type) {
+		case ProxyData::CHelloType::Chrome:
+			// qDebug(">>> using Chrome ClientHello");
+			return result(chRules_chrome, ch_type);
+		case ProxyData::CHelloType::Custom:
+			// qDebug(">>> using custom ClientHello");
+			return result(chRules_custom, ch_type);
+		case ProxyData::CHelloType::SafariMac:
+			return result(chRules_safari, ch_type);
+		case ProxyData::CHelloType::YandexGost:
+			return result(chRules_yandex, ch_type);
+		case ProxyData::CHelloType::Chromium150: {
+			const auto ticket = TakeChromium150Ticket(
+				Chromium150EndpointKey(address, port, domain));
+			if (ticket.taken) {
+				ProxyData::updateGlobalCHelloStatusLifetime(
+					address,
+					port,
+					ClientHelloDomainId(domain),
+					int(ticket.maximumRemaining.count()));
+			}
+			return result(
+				ticket.taken
+					? chRules_chromium150Resumed
+					: chRules_chromium150Fresh,
+				ch_type,
+				ticket.taken);
+		}
+		case ProxyData::CHelloType::Firefox:
+		default:
+			// qDebug(">>> using FireFox ClientHello");
+			return result(chRules_firefox, ProxyData::CHelloType::Firefox);
+	}
+}
