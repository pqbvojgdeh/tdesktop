+		return entry.value.port == status.port
+			&& !entry.value.host.compare(status.host, Qt::CaseInsensitive)
+			&& entry.value.domainId == status.domainId;
+	};
+	if (const auto i = ranges::find_if(CHelloStatuses, sameEndpoint);
+		i != end(CHelloStatuses)) {
+		i->value = status;
+		i->connectedAt = now;
+		i->ttlUpdatedAt = now;
+	} else {
+		CHelloStatuses.push_back({ status, now, now });
+		if (CHelloStatuses.size() > kMaximumStoredCHelloStatuses) {
+			const auto oldest = std::min_element(
+				begin(CHelloStatuses),
+				end(CHelloStatuses),
+				[](const auto &a, const auto &b) {
+					return a.connectedAt < b.connectedAt;
+				});
+			CHelloStatuses.erase(oldest);
+		}
+	}
+}
+
+void ProxyData::updateGlobalCHelloStatusLifetime(
+		const QString &host,
+		uint32 port,
+		const QByteArray &domainId,
+		int ttlMinutes) {
+	const QMutexLocker lock(&CHelloStatusMutex);
+	const auto matches = [&](const StoredCHelloStatus &entry) {
+		return entry.value.port == port
+			&& !entry.value.host.compare(host, Qt::CaseInsensitive)
+			&& entry.value.domainId == domainId;
+	};
+	if (const auto i = ranges::find_if(CHelloStatuses, matches);
+		i != end(CHelloStatuses)) {
+		i->value.ttlMinutes = std::max(ttlMinutes, 0);
+		i->value.ttlLeftMinutes = i->value.ttlMinutes;
+		i->ttlUpdatedAt = crl::now();
+	}
+}
+
+void ProxyData::clearGlobalCHelloStatuses() {
+	const QMutexLocker lock(&CHelloStatusMutex);
+	CHelloStatuses.clear();
+}
+
+void ProxyData::setGlobalSlowMode(bool value) {
+	global_slow_mode.store(value, std::memory_order_relaxed);
+}
+
+ProxyData::CHelloStatus ProxyData::globalCHelloStatus(
+		const ProxyData &proxy) {
+	const QMutexLocker lock(&CHelloStatusMutex);
+	const auto domainId = DomainId(proxy);
+	const auto matches = [&](const StoredCHelloStatus &entry) {
+		if (entry.value.port != proxy.port
+			|| entry.value.domainId != domainId) {
+			return false;
+		}
+		const auto isHost = [&](const QString &host) {
+			return !entry.value.host.compare(host, Qt::CaseInsensitive);
+		};
+		return isHost(proxy.host) || std::any_of(
+			begin(proxy.resolvedIPs),
+			end(proxy.resolvedIPs),
+			isHost);
+	};
+	const auto newest = [&] {
+		auto result = (const StoredCHelloStatus*)nullptr;
+		for (const auto &entry : CHelloStatuses) {
+			if (matches(entry)
+				&& (!result || entry.connectedAt >= result->connectedAt)) {
+				result = &entry;
+			}
+		}
+		return result;
+	}();
+	if (!newest) {
+		return CHelloStatus();
+	}
+	auto result = newest->value;
+	if (result.chromium150 && result.ttlLeftMinutes > 0) {
+		const auto elapsedMinutes = std::clamp(
+			(crl::now() - newest->ttlUpdatedAt) / crl::time(60 * 1000),
+			crl::time(0),
+			crl::time(result.ttlLeftMinutes));
+		result.ttlLeftMinutes = std::max(
+			0,
+			result.ttlLeftMinutes - int(elapsedMinutes));
+	}
+	return result;
+}
+
+bool ProxyData::globalSlowMode() {
+	return global_slow_mode.load(std::memory_order_relaxed);
+}
+
+void ProxyData::setGlobalSlowDelay(int value) {
+	global_slow_delay.store(
+		std::clamp(value, 0, kMaximumSlowTimingValue),
+		std::memory_order_relaxed);
+}
+
+int ProxyData::globalSlowDelay() {
+	return global_slow_delay.load(std::memory_order_relaxed);
+}
+
+void ProxyData::setGlobalSlowJitter(int value) {
+	global_slow_jitter.store(
+		std::clamp(value, 0, kMaximumSlowTimingValue),
+		std::memory_order_relaxed);
+}
+
+int ProxyData::globalSlowJitter() {
+	return global_slow_jitter.load(std::memory_order_relaxed);
+}
+
+void ProxyData::setGlobalPreferIPv6(bool value) {
+	global_prefer_ipv6.store(value, std::memory_order_relaxed);
+}
+
+bool ProxyData::globalPreferIPv6() {
+	return global_prefer_ipv6.load(std::memory_order_relaxed);
+}
+
+bool ProxyData::addressComesFirst(
+		const QString &first,
+		const QString &second,
+		bool preferIPv6) {
+	const auto firstV6 = qthelp::is_ipv6(first);
+	const auto secondV6 = qthelp::is_ipv6(second);
+	return (firstV6 == secondV6)
+		? false
+		: (firstV6 == preferIPv6);
+}
+
 } // namespace MTP
