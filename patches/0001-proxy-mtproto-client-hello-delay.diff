+[[nodiscard]] MTPTlsClientHello PrepareClientHelloRules(const QString &address, int port)
+{
+	static MTPTlsClientHello chRules_chrome  = PrepareClientHelloRules_Chrome();
+	static MTPTlsClientHello chRules_firefox = PrepareClientHelloRules_Firefox();
+	static MTPTlsClientHello chRules_custom  = PrepareClientHelloRules_Firefox(true);
+	static MTPTlsClientHello chRules_safari  = PrepareClientHelloRules_SafariMac();
+	static MTPTlsClientHello chRules_yandex  = PrepareClientHelloRules_YandexGost();
+	static MTPTlsClientHello chRules_chromium150Fresh = PrepareClientHelloRules_Chromium150(false);
+	static MTPTlsClientHello chRules_chromium150Resumed = PrepareClientHelloRules_Chromium150(true);
+	static QMutex chromium150Mutex;
+	struct Chromium150EndpointState {
+		std::chrono::steady_clock::time_point seenAt;
+		std::chrono::minutes ttl;
+	};
+	static auto chromium150SeenByEndpoint = std::map<std::pair<QString, int>, Chromium150EndpointState>();
+	const auto configured_ch_type = MTP::ProxyData::globalClienHelloRulesType();
+	auto ch_type = configured_ch_type;
+	if (ProxyData::CHelloType::RANDOM == ch_type) {
+		// qDebug("--- randomize ClientHello selection");
+		ch_type = Core::IntToProxyCHelloType(QRandomGenerator::global()->bounded(0, 6));
+	}
+	const auto saveStatus = [&](ProxyData::CHelloType actual_ch_type, bool resumed = false, int ttlMinutes = 0, int ttlLeftMinutes = 0) {
+		auto status = MTP::ProxyData::CHelloStatus();
+		status.configured = configured_ch_type;
+		status.actual = actual_ch_type;
+		status.endpoint = QString("%1:%2").arg(address).arg(port);
+		status.random = (configured_ch_type == ProxyData::CHelloType::RANDOM);
+		status.chromium150 = (actual_ch_type == ProxyData::CHelloType::Chromium150);
+		status.resumed = resumed;
+		status.ttlMinutes = ttlMinutes;
+		status.ttlLeftMinutes = ttlLeftMinutes;
+		status.used = true;
+		MTP::ProxyData::setGlobalCHelloStatus(status);
+	};
+	switch(ch_type) {
+		case ProxyData::CHelloType::Chrome:
+			// qDebug(">>> using Chrome ClientHello");
+			saveStatus(ch_type);
+			return chRules_chrome;
+		case ProxyData::CHelloType::Custom:
+			// qDebug(">>> using custom ClientHello");
+			saveStatus(ch_type);
+			return chRules_custom;
+		case ProxyData::CHelloType::SafariMac:
+			saveStatus(ch_type);
+			return chRules_safari;
+		case ProxyData::CHelloType::YandexGost:
+			saveStatus(ch_type);
+			return chRules_yandex;
+		case ProxyData::CHelloType::Chromium150: {
+			int ttlMinutes = 0;
+			int ttlLeftMinutes = 0;
+			const auto resumed = [&] {
+				namespace sc = std::chrono;
+				const QMutexLocker lock(&chromium150Mutex);
+				const auto now = sc::steady_clock::now();
+				auto &state = chromium150SeenByEndpoint[{ address, port }];
+				const auto result = state.seenAt.time_since_epoch().count() != 0
+					&& now - state.seenAt < state.ttl;
+				if (!result) {
+					state.ttl = sc::minutes(30 + QRandomGenerator::global()->bounded(31));
+					state.seenAt = now;
+				}
+				ttlMinutes = int(state.ttl.count());
+				const auto elapsed = result
+					? int(sc::duration_cast<sc::minutes>(now - state.seenAt).count())
+					: 0;
+				ttlLeftMinutes = ttlMinutes - elapsed;
+				if (ttlLeftMinutes < 0) {
+					ttlLeftMinutes = 0;
+				}
+				return result;
+			}();
+			saveStatus(ch_type, resumed, ttlMinutes, ttlLeftMinutes);
+			return resumed
+				? chRules_chromium150Resumed
+				: chRules_chromium150Fresh;
+		}
+		case ProxyData::CHelloType::Firefox:
+		default:
+			// qDebug(">>> using FireFox ClientHello");
+			saveStatus(ProxyData::CHelloType::Firefox);
+			return chRules_firefox;
+	}
+}
