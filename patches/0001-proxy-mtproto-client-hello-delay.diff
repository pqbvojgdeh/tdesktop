+#pragma once
+
+#include <algorithm>
+#include <chrono>
+#include <cstddef>
+#include <iterator>
+#include <map>
+#include <mutex>
+#include <utility>
+#include <vector>
+
+namespace MTP::details {
+
+template <typename Key>
+class ChromiumSessionCache final {
+public:
+	using Clock = std::chrono::steady_clock;
+	using TimePoint = Clock::time_point;
+	using Lifetime = std::chrono::minutes;
+	struct TakeResult {
+		bool taken = false;
+		Lifetime maximumRemaining = Lifetime(0);
+	};
+
+	ChromiumSessionCache(std::size_t maximumEntries, int ticketSlots)
+	: _maximumEntries(maximumEntries)
+	, _ticketSlots(std::max(ticketSlots, 0)) {
+	}
+
+	[[nodiscard]] bool take(const Key &key, TimePoint now = Clock::now()) {
+		return takeWithRemaining(key, now).taken;
+	}
+
+	[[nodiscard]] TakeResult takeWithRemaining(
+			const Key &key,
+			TimePoint now = Clock::now()) {
+		const auto lock = std::lock_guard(_mutex);
+		prune(now);
+		const auto i = _entries.find(key);
+		if (i == end(_entries)) {
+			return {};
+		}
+		i->second.pop_back();
+		if (i->second.empty()) {
+			_entries.erase(i);
+			return { true, Lifetime(0) };
+		}
+		const auto expiry = *std::max_element(
+			begin(i->second),
+			end(i->second));
+		return {
+			true,
+			std::chrono::duration_cast<Lifetime>(expiry - now),
+		};
+	}
+
+	template <typename LifetimeGenerator>
+	[[nodiscard]] Lifetime confirm(
+			const Key &key,
+			LifetimeGenerator &&generateLifetime,
+			TimePoint now = Clock::now()) {
+		const auto lock = std::lock_guard(_mutex);
+		prune(now);
+		if (!_maximumEntries || !_ticketSlots) {
+			return Lifetime(0);
+		}
+		if (!_entries.contains(key) && _entries.size() >= _maximumEntries) {
+			eraseEarliestExpiring();
+		}
+		auto tickets = std::vector<TimePoint>();
+		tickets.reserve(_ticketSlots);
+		auto longest = Lifetime(0);
+		for (auto slot = 0; slot != _ticketSlots; ++slot) {
+			const auto lifetime = std::max(
+				Lifetime(1),
+				Lifetime(generateLifetime()));
+			tickets.push_back(now + lifetime);
+			longest = std::max(longest, lifetime);
+		}
+		_entries.insert_or_assign(key, std::move(tickets));
+		return longest;
+	}
+
+	[[nodiscard]] std::size_t ticketCount(
+			const Key &key,
+			TimePoint now = Clock::now()) {
+		const auto lock = std::lock_guard(_mutex);
+		prune(now);
+		const auto i = _entries.find(key);
+		return (i == end(_entries)) ? 0 : i->second.size();
+	}
+
+private:
+	using Tickets = std::vector<TimePoint>;
+
+	void prune(TimePoint now) {
+		for (auto i = _entries.begin(); i != _entries.end();) {
+			auto &tickets = i->second;
+			tickets.erase(
+				std::remove_if(
+					begin(tickets),
+					end(tickets),
+					[=](TimePoint expiry) { return expiry <= now; }),
+				end(tickets));
+			i = tickets.empty() ? _entries.erase(i) : std::next(i);
+		}
+	}
+
+	void eraseEarliestExpiring() {
+		const auto oldest = std::min_element(
+			begin(_entries),
+			end(_entries),
+			[](const auto &a, const auto &b) {
+				return *std::max_element(begin(a.second), end(a.second))
+					< *std::max_element(begin(b.second), end(b.second));
+			});
+		if (oldest != end(_entries)) {
+			_entries.erase(oldest);
+		}
