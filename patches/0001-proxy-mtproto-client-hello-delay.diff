+struct ClientHelloSelection {
+	const MTPTlsClientHello *rules = nullptr;
+	ProxyData::CHelloType configured = ProxyData::CHelloType::Chromium150;
+	ProxyData::CHelloType actual = ProxyData::CHelloType::Chromium150;
+	bool resumed = false;
+};
+
+constexpr auto kMaximumChromium150EndpointStates = 128;
+constexpr auto kChromium150TicketSlots = 2;
+auto Chromium150Sessions = MTP::details::ChromiumSessionCache<
+	Chromium150EndpointKey>(
+		kMaximumChromium150EndpointStates,
+		kChromium150TicketSlots);
+
+[[nodiscard]] auto TakeChromium150Ticket(
+		const Chromium150EndpointKey &key) {
+	return Chromium150Sessions.takeWithRemaining(key);
+}
+
+void ConfirmClientHello(
+		const QString &address,
+		int port,
+		const QByteArray &domain,
+		ProxyData::CHelloType configured,
+		ProxyData::CHelloType actual,
+		bool resumed) {
+	auto ttlMinutes = 0;
+	if (actual == ProxyData::CHelloType::Chromium150) {
+		const auto key = Chromium150EndpointKey(address, port, domain);
+		ttlMinutes = int(Chromium150Sessions.confirm(key, [] {
+			return std::chrono::minutes(
+				30 + QRandomGenerator::global()->bounded(31));
+		}).count());
+	}
+
+	auto status = ProxyData::CHelloStatus();
+	status.configured = configured;
+	status.actual = actual;
+	status.host = address;
+	status.port = port;
+	status.domainId = ClientHelloDomainId(domain);
+	status.random = (configured == ProxyData::CHelloType::RANDOM);
+	status.chromium150 = (actual == ProxyData::CHelloType::Chromium150);
+	status.resumed = resumed;
+	status.ttlMinutes = ttlMinutes;
+	status.ttlLeftMinutes = ttlMinutes;
