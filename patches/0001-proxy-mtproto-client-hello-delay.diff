+[[nodiscard]] bool UsesFakeTls(const ProxyData &proxy) {
+	if (proxy.type != ProxyData::Type::Mtproto) {
+		return false;
+	}
+	const auto secret = proxy.secretFromMtprotoPassword();
+	return secret.size() >= 21 && secret[0] == bytes::type(0xEE);
+}
+
+[[nodiscard]] QString ClientHelloName(ProxyData::CHelloType type) {
+	switch (type) {
+	case ProxyData::CHelloType::Chrome:
+		return u"Google Chrome (Telegram profile)"_q;
+	case ProxyData::CHelloType::Custom:
+		return u"Mozilla Firefox 151 — permuted extensions"_q;
+	case ProxyData::CHelloType::SafariMac:
+		return u"Apple Safari 26.4 (macOS)"_q;
+	case ProxyData::CHelloType::YandexGost:
+		return u"Yandex Browser (GOST)"_q;
+	case ProxyData::CHelloType::Chromium150:
+		return u"Chromium 150"_q;
+	case ProxyData::CHelloType::RANDOM:
+		return u"Random on each connection"_q;
+	case ProxyData::CHelloType::Firefox:
+	default:
+		return u"Mozilla Firefox 151"_q;
+	}
+}
+
+[[nodiscard]] QString ClientHelloStatusText(const ProxyData &proxy) {
+	const auto status = ProxyData::globalCHelloStatus(proxy);
+	if (!status.used) {
+		return u"Last connection\nNot used yet"_q;
+	}
+	auto result = u"Last connection\n"_q;
+	if (status.random) {
+		result += u"Random selection · "_q;
+	}
+	result += ClientHelloName(status.actual);
+	if (status.chromium150) {
+		result += status.resumed
+			? u" · resumed profile"_q
+			: u" · fresh profile"_q;
+	}
+	if (!status.endpoint.isEmpty()) {
+		result += u"\n"_q + status.endpoint;
+	}
+	if (status.chromium150 && status.ttlMinutes > 0) {
+		result += status.resumed
+			? u"\nProfile refresh in %1 min"_q.arg(status.ttlLeftMinutes)
+			: u"\nResume window: %1 min"_q.arg(status.ttlLeftMinutes);
 	}
 	return result;
 }
 
+[[nodiscard]] QString SlowModeSummary(const Core::SettingsProxy &settings) {
+	return settings.proxySlowMode()
+		? u"Current range: %1–%2 ms"_q
+			.arg(settings.proxySlowDelay())
+			.arg(settings.proxySlowDelay() + settings.proxySlowJitter())
+		: u"No additional delay"_q;
+}
