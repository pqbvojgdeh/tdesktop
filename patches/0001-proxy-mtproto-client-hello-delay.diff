+void ProxiesBoxController::refreshAllChecks() {
+	if (_checksRunning.current()) {
+		return;
+	}
+	_batchChecksLeft = ranges::count(_list, false, &Item::deleted);
+	_checksRunning = (_batchChecksLeft > 0);
+	if (!_batchChecksLeft) {
+		finishChecksBatch();
+		return;
+	}
+	for (auto &item : _list) {
+		if (!item.deleted) {
+			refreshChecker(item, true);
+		}
 	}
