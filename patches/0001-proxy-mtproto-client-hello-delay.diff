+
+void ProxiesBox::refreshProxyCHelloStatus() {
+	if (!_proxyCHelloStatus) {
+		return;
+	}
+	if (!_controller->selectedUsesFakeTls()) {
+		_proxyCHelloReconnectPending = false;
+		_proxyCHelloStatus->setText(
+			u"Available for MTProto FakeTLS proxies"_q);
+		return;
+	}
+	const auto status = ProxyData::globalCHelloStatus(_settings.selected());
+	const auto currentProfileApplied = status.used
+		&& (status.configured == _settings.proxyCHelloType());
+	if (_proxyCHelloReconnectPending && !currentProfileApplied) {
+		_proxyCHelloStatus->setText(
+			u"Reconnecting\nSelected profile: "_q
+			+ ClientHelloName(_settings.proxyCHelloType()));
+		return;
+	}
+	_proxyCHelloReconnectPending = false;
+	_proxyCHelloStatus->setText(ClientHelloStatusText(_settings.selected()));
+}
+
+void ProxiesBox::refreshCustomControls() {
+	if (!_proxySettings) {
+		return;
+	}
+	const auto custom = _settings.isEnabled();
+	const auto fakeTls = _controller->selectedUsesFakeTls();
+	const auto setButtonEnabled = [](Ui::SettingsButton *button, bool enabled) {
+		button->setDisabled(!enabled);
+		button->setToggleLocked(!enabled);
+		button->setColorOverride(enabled
+			? std::nullopt
+			: std::optional<QColor>(st::windowSubTextFg->c));
+		button->setEnabled(enabled);
+	};
+	const auto setFieldEnabled = [](QLineEdit *field, bool enabled) {
+		field->setReadOnly(!enabled);
+		field->setEnabled(enabled);
+	};
+	if (_proxyAddressPriorityButton) {
+		setButtonEnabled(
+			_proxyAddressPriorityButton,
+			custom && _controller->selectedUsesHostname());
+	}
+	if (_proxyCHelloButton) {
+		setButtonEnabled(_proxyCHelloButton, custom && fakeTls);
+	}
+	if (_proxyCHelloStatus) {
+		_proxyCHelloStatus->setDisabled(!custom || !fakeTls);
+	}
+	if (_proxySlowMode) {
+		setButtonEnabled(_proxySlowMode, custom && fakeTls);
+	}
+	if (_proxySlowSummary) {
+		_proxySlowSummary->setDisabled(!custom || !fakeTls);
+	}
+	if (_proxySlowDelayInput) {
+		setFieldEnabled(
+			_proxySlowDelayInput,
+			custom && fakeTls && _proxySlowMode->toggled());
+	}
+	if (_proxySlowJitterInput) {
+		setFieldEnabled(
+			_proxySlowJitterInput,
+			custom && fakeTls && _proxySlowMode->toggled());
+	}
+	if (_proxyForCalls) {
+		setButtonEnabled(_proxyForCalls->entity(), custom);
+	}
+	if (_proxyRotation) {
+		setButtonEnabled(_proxyRotation->entity(), custom);
+	}
+	if (_proxyRotationTimeoutInput) {
+		setFieldEnabled(
+			_proxyRotationTimeoutInput,
+			custom && _proxyRotation->entity()->toggled());
+	}
+	if (_refreshChecksButton) {
+		setButtonEnabled(
+			_refreshChecksButton,
+			custom && _checksCaption.current() != u"Checking…"_q);
+	}
+	for (const auto &[id, row] : _rows) {
+		row->setSelectionEnabled(custom);
+	}
+	refreshProxySlowMode();
+	refreshProxyRotation();
+	refreshProxyCHelloStatus();
 }
 
