+		namespace sc = std::chrono;
+		static QMutex mutex;
+		static auto slots = std::map<std::pair<QString, int>, sc::steady_clock::time_point>{};
+		const auto delay = qMax(1, MTP::ProxyData::globalSlowDelay());
+		const auto jitter = qMax(0, MTP::ProxyData::globalSlowJitter());
+
+		sc::milliseconds waitFor{0};
+		{
+			const QMutexLocker lock(&mutex);
+			const auto now = sc::steady_clock::now();
+			const auto extra = jitter ? QRandomGenerator::global()->bounded(jitter + 1) : 0;
+			const auto gap = delay + extra;
+			auto &slot = slots[{ address, port }];
+			if (slot.time_since_epoch().count() != 0) {
+				if (now < slot) {
+					waitFor = sc::duration_cast<sc::milliseconds>(
+						slot - now);
+				} else {
+					slot = sc::steady_clock::time_point{};
+				}
+			}
+			if (slot.time_since_epoch().count() == 0) {
+				slot = now + sc::milliseconds(gap);
+			} else {
+				slot += sc::milliseconds(gap);
+			}
+		}
+		if (waitFor.count() > 0) {
+			const auto _address = address;
+			const auto _port    = port;
+			QTimer::singleShot(waitFor.count(), this, [=] {
+				if (_state == State::Connecting) {
+					_socket.connectToHost(_address, _port);
+				}
+			});
+			return;
+		}
+	}
 	_socket.connectToHost(address, port);
 }
 
