@@ -0,0 +1,65 @@
+/*
+This file is part of Telegram Desktop,
+the official desktop application for the Telegram messaging service.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#pragma once
+
+#include <algorithm>
+#include <chrono>
+
+namespace MTP::details {
+
+inline constexpr auto kSlowConnectMaximumAdditionalDelayMs = 7500;
+inline constexpr auto kSlowConnectSchedulingMarginMs = 500;
+inline constexpr auto kSlowConnectMaximumTimeoutBudgetMs
+	= kSlowConnectMaximumAdditionalDelayMs
+	+ kSlowConnectSchedulingMarginMs;
+inline constexpr auto kSlowConnectMaximumPending = 16;
+inline constexpr auto kSlowConnectMaximumSlots = 128;
+inline constexpr auto kSlowConnectOverflowMinimumDelayMs = 100;
+inline constexpr auto kSlowConnectOverflowMaximumDelayMs = 300;
+
+struct SlowConnectPolicy final {
+	int delay = 0;
+	int jitter = 0;
+};
+
+[[nodiscard]] constexpr SlowConnectPolicy NormalizeSlowConnectPolicy(
+		int delay,
+		int jitter) {
+	const auto normalizedDelay = std::clamp(
+		delay,
+		0,
+		kSlowConnectMaximumAdditionalDelayMs);
+	return {
+		normalizedDelay,
+		std::clamp(
+			jitter,
+			0,
+			kSlowConnectMaximumAdditionalDelayMs - normalizedDelay),
+	};
+}
+
+[[nodiscard]] constexpr auto SlowConnectMaximumAdditionalDelay(
+		int delay,
+		int jitter) {
+	const auto policy = NormalizeSlowConnectPolicy(delay, jitter);
+	return std::chrono::milliseconds(policy.delay + policy.jitter);
+}
+
+[[nodiscard]] constexpr int NormalizeSlowConnectOverflowDelay(int value) {
+	return std::clamp(
+		value,
+		kSlowConnectOverflowMinimumDelayMs,
+		kSlowConnectOverflowMaximumDelayMs);
+}
+
+static_assert(kSlowConnectOverflowMinimumDelayMs > 0);
+static_assert(
+	kSlowConnectOverflowMinimumDelayMs
+		<= kSlowConnectOverflowMaximumDelayMs);
+
+} // namespace MTP::details
