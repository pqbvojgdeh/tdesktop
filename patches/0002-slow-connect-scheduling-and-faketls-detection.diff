+/*
+This file is part of Telegram Desktop,
+the official desktop application for the Telegram messaging service.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#pragma once
+
+#include <cstddef>
+#include <type_traits>
+
+namespace MTP::details {
+
+// 0xEE + 16 secret bytes + at least four domain bytes, matching
+// ProxyData validation and TcpConnection::Protocol::Create.
+inline constexpr auto kFakeTlsMinimumSecretSize = std::size_t(21);
+
+template <typename Span>
+[[nodiscard]] constexpr bool IsFakeTlsSecret(const Span &secret) {
+	using Byte = std::remove_cvref_t<decltype(secret.front())>;
+	return secret.size() >= kFakeTlsMinimumSecretSize
+		&& secret.front() == Byte(0xEE);
+}
+
+} // namespace MTP::details
diff --git a/Telegram/SourceFiles/mtproto/details/mtproto_slow_connect_policy.h b/Telegram/SourceFiles/mtproto/details/mtproto_slow_connect_policy.h
