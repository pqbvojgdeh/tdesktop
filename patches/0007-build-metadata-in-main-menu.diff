 namespace Window {
 
+QString ResolveEmbeddedBuildMetadata(
+		QString embedded,
+		QString fallback) {
+	const auto placeholder = embedded.startsWith(u"__TDESKTOP_"_q)
+		&& embedded.endsWith(u"__"_q);
+	return placeholder ? fallback : embedded;
+}
