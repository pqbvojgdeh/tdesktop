+#pragma once
+
+namespace MTP::details {
+
+class ProxyCheckCoordinatorState final {
+public:
+	[[nodiscard]] constexpr bool canStart(int maximum) const {
+		return maximum > 0 && _active < maximum;
+	}
+
+	[[nodiscard]] constexpr bool start(int maximum) {
+		if (!canStart(maximum)) {
+			return false;
+		}
+		++_active;
+		return true;
+	}
+
+	[[nodiscard]] constexpr bool finish(bool wasActive) {
+		if (!wasActive) {
+			return true;
+		} else if (_active <= 0) {
+			return false;
+		}
+		--_active;
+		return true;
+	}
+
+	[[nodiscard]] constexpr int active() const {
+		return _active;
+	}
+
+	[[nodiscard]] constexpr bool valid() const {
+		return _active >= 0;
+	}
+
+private:
+	int _active = 0;
+};
+
+} // namespace MTP::details
