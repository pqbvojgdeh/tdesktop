diff --git a/Telegram/SourceFiles/mtproto/proxy_check.cpp b/Telegram/SourceFiles/mtproto/proxy_check.cpp
index 831c845..0174e24 100644
--- a/Telegram/SourceFiles/mtproto/proxy_check.cpp
+++ b/Telegram/SourceFiles/mtproto/proxy_check.cpp
@@ -6,14 +6,278 @@ For license and copyright information please follow this link:
 https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
 */
 #include "mtproto/proxy_check.h"
+#include "mtproto/details/mtproto_proxy_check_coordinator_policy.h"
 
+#include "base/timer.h"
 #include "mtproto/facade.h"
 #include "mtproto/mtproto_dc_options.h"
 
+#include <QtCore/QCoreApplication>
+#include <QtCore/QPointer>
+#include <QtCore/QThread>
+
+#include <algorithm>
+#include <optional>
+
 namespace MTP {
 
 using Connection = details::AbstractConnection;
 
+class ProxyCheckHandle final {
+public:
+	ProxyCheckHandle(Fn<void(int)> done, Fn<void()> fail)
+	: done(std::move(done))
+	, fail(std::move(fail)) {
+	}
+
+	Fn<void(int)> done;
+	Fn<void()> fail;
+};
+
+namespace {
+
+constexpr auto kMaxConcurrentProxyChecks = 2;
+constexpr auto kProxyCheckLifetime = 20 * crl::time(1000);
+constexpr auto kProxyCheckTimerInterval = crl::time(1000);
+
+void AssertProxyCheckCoordinatorThread() {
+	const auto application = QCoreApplication::instance();
+	Expects(application != nullptr);
+	Expects(QThread::currentThread() == application->thread());
+}
+
+class ProxyCheckCoordinator final {
+public:
+	ProxyCheckCoordinator()
+	: _timer([=] { pruneExpired(); })
+	, _queueTimer([=] { startQueued(); }) {
+	}
+
+	ProxyCheckHandlePointer schedule(
+			not_null<Instance*> mtproto,
+			const ProxyData &proxy,
+			bool tryIPv6,
+			Fn<void(int)> done,
+			Fn<void()> fail) {
+		AssertProxyCheckCoordinatorThread();
+		auto handle = std::make_shared<ProxyCheckHandle>(
+			std::move(done),
+			std::move(fail));
+		for (const auto &entry : _entries) {
+			if (entry->mtproto == mtproto.get()
+				&& entry->proxy == proxy
+				&& entry->tryIPv6 == tryIPv6) {
+				entry->listeners.push_back(handle);
+				return handle;
+			}
+		}
+		auto entry = std::make_unique<Entry>();
+		entry->id = nextId();
+		entry->mtproto = mtproto.get();
+		entry->proxy = proxy;
+		entry->tryIPv6 = tryIPv6;
+		entry->listeners.push_back(handle);
+		_entries.push_back(std::move(entry));
+		startQueued();
+		return handle;
+	}
+
+private:
+	struct Entry {
+		uint64 id = 0;
+		QPointer<Instance> mtproto;
+		ProxyData proxy;
+		bool tryIPv6 = false;
+		bool active = false;
+		bool starting = false;
+		bool finished = false;
+		crl::time startedAt = 0;
+		ProxyCheckConnection v4;
+		ProxyCheckConnection v6;
+		std::vector<std::weak_ptr<ProxyCheckHandle>> listeners;
+		std::optional<int> pendingPing;
+	};
+
+	[[nodiscard]] Entry *find(uint64 id) {
+		const auto i = ranges::find(
+			_entries,
+			id,
+			[](const std::unique_ptr<Entry> &entry) { return entry->id; });
+		return (i == end(_entries)) ? nullptr : i->get();
+	}
+
+	[[nodiscard]] uint64 nextId() {
+		do {
+			++_idCounter;
+		} while (!_idCounter || find(_idCounter));
+		return _idCounter;
+	}
+
+	void startQueued() {
+		AssertProxyCheckCoordinatorThread();
+		while (_state.canStart(kMaxConcurrentProxyChecks)) {
+			const auto i = ranges::find(
+				_entries,
+				false,
+				[](const std::unique_ptr<Entry> &entry) {
+					return entry->active;
+				});
+			if (i == end(_entries)) {
+				break;
+			}
+			auto &entry = **i;
+			entry.listeners.erase(
+				std::remove_if(
+					begin(entry.listeners),
+					end(entry.listeners),
+					[](const auto &listener) { return listener.expired(); }),
+				end(entry.listeners));
+			if (entry.listeners.empty() || !entry.mtproto) {
+				_entries.erase(i);
+				continue;
+			}
+			const auto mtproto = entry.mtproto.data();
+			if (!mtproto) {
+				_entries.erase(i);
+				continue;
+			}
+			entry.active = true;
+			entry.starting = true;
+			entry.startedAt = crl::now();
+			const auto slotStarted = _state.start(kMaxConcurrentProxyChecks);
+			Expects(slotStarted);
+			const auto id = entry.id;
+			StartProxyCheck(
+				not_null<Instance*>(mtproto),
+				entry.proxy,
+				entry.tryIPv6,
+				entry.v4,
+				entry.v6,
+				[=](Connection *raw, int ping) {
+					checkDone(id, raw, ping);
+				},
+				[=](Connection *raw) {
+					checkFailed(id, raw);
+				});
+			const auto started = find(id);
+			if (!started) {
+				continue;
+			}
+			started->starting = false;
+			if (started->pendingPing) {
+				finish(id, started->pendingPing);
+			} else if (!HasProxyCheckers(started->v4, started->v6)) {
+				finish(id, std::nullopt);
+			}
+		}
+		armTimer();
+	}
+
+	void armTimer() {
+		if (_state.active() > 0 && !_timer.isActive()) {
+			_timer.callOnce(kProxyCheckTimerInterval);
+		}
+	}
+
+	void pruneExpired() {
+		AssertProxyCheckCoordinatorThread();
+		const auto now = crl::now();
+		auto expired = std::vector<uint64>();
+		for (auto &entry : _entries) {
+			entry->listeners.erase(
+				std::remove_if(
+					begin(entry->listeners),
+					end(entry->listeners),
+					[](const auto &listener) { return listener.expired(); }),
+				end(entry->listeners));
+			if (entry->active
+				&& (!entry->mtproto
+					|| entry->listeners.empty()
+					|| (now - entry->startedAt >= kProxyCheckLifetime))) {
+				expired.push_back(entry->id);
+			}
+		}
+		for (const auto id : expired) {
+			finish(id, std::nullopt);
+		}
+		armTimer();
+	}
+
+	void checkDone(uint64 id, not_null<Connection*> raw, int ping) {
+		AssertProxyCheckCoordinatorThread();
+		const auto entry = find(id);
+		if (!entry || entry->finished) {
+			return;
+		}
+		DropProxyChecker(entry->v4, entry->v6, raw);
+		const auto normalized = std::max(ping, 1);
+		if (entry->starting) {
+			entry->pendingPing = normalized;
+		} else {
+			finish(id, normalized);
+		}
+	}
+
+	void checkFailed(uint64 id, not_null<Connection*> raw) {
+		AssertProxyCheckCoordinatorThread();
+		const auto entry = find(id);
+		if (!entry || entry->finished) {
+			return;
+		}
+		DropProxyChecker(entry->v4, entry->v6, raw);
+		if (!entry->starting && !HasProxyCheckers(entry->v4, entry->v6)) {
+			finish(id, std::nullopt);
+		}
+	}
+
+	void finish(uint64 id, std::optional<int> ping) {
+		AssertProxyCheckCoordinatorThread();
+		const auto entry = find(id);
+		if (!entry || entry->finished) {
+			return;
+		}
+		entry->finished = true;
+		ResetProxyCheckers(entry->v4, entry->v6);
+		auto listeners = std::move(entry->listeners);
+		const auto wasActive = entry->active;
+		const auto i = ranges::find(
+			_entries,
+			id,
+			[](const std::unique_ptr<Entry> &entry) { return entry->id; });
+		_entries.erase(i);
+		const auto finished = _state.finish(wasActive);
+		Expects(finished);
+		Expects(_state.valid());
+		for (const auto &weak : listeners) {
+			if (const auto strong = weak.lock()) {
+				if (ping) {
+					if (strong->done) {
+						strong->done(*ping);
+					}
+				} else if (strong->fail) {
+					strong->fail();
+				}
+			}
+		}
+		if (!_queueTimer.isActive()) {
+			_queueTimer.callOnce(0);
+		}
+	}
+
+	uint64 _idCounter = 0;
+	details::ProxyCheckCoordinatorState _state;
+	std::vector<std::unique_ptr<Entry>> _entries;
+	base::Timer _timer;
+	base::Timer _queueTimer;
+};
+
+[[nodiscard]] ProxyCheckCoordinator &Coordinator() {
+	static const auto result = new ProxyCheckCoordinator();
+	return *result;
+}
+
+} // namespace
+
 void ResetProxyCheckers(
 		ProxyCheckConnection &v4,
 		ProxyCheckConnection &v6) {
@@ -108,4 +372,18 @@ void StartProxyCheck(
 	tryConnect(v6, Variants::IPv6);
 }
 
+ProxyCheckHandlePointer ScheduleProxyCheck(
+		not_null<Instance*> mtproto,
+		const ProxyData &proxy,
+		bool tryIPv6,
+		Fn<void(int ping)> done,
+		Fn<void()> fail) {
+	return Coordinator().schedule(
+		mtproto,
+		proxy,
+		tryIPv6,
+		std::move(done),
+		std::move(fail));
+}
+
 } // namespace MTP
