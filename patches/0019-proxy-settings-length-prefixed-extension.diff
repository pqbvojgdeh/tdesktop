@@ -0,0 +1,46 @@
+/*
+This file is part of Telegram Desktop,
+the official desktop application for the Telegram messaging service.
+
+For license and copyright information please follow this link:
+https://github.com/telegramdesktop/tdesktop/blob/master/LEGAL
+*/
+#pragma once
+
+#include <cstdint>
+
+namespace Core::details {
+
+inline constexpr auto kProxySettingsExtensionMagic = std::int32_t(0x54505831);
+inline constexpr auto kProxySettingsLegacyExtensionVersion = std::int32_t(1);
+inline constexpr auto kProxySettingsExtensionVersion = std::int32_t(2);
+inline constexpr auto kProxySettingsExtensionFieldCount = 5;
+inline constexpr auto kMaximumProxySettingsExtensionBytes = 4096;
+
+struct ProxySettingsExtensionFields final {
+	std::int32_t clientHelloType = -1;
+	std::int32_t slowMode = 0;
+	std::int32_t slowDelay = 250;
+	std::int32_t slowJitter = 150;
+	std::int32_t preferIPv6 = 0;
+};
+
+[[nodiscard]] constexpr bool IsProxySettingsBoolean(std::int32_t value) {
+	return value == 0 || value == 1;
+}
+
+[[nodiscard]] constexpr bool IsProxySettingsExtensionValid(
+		const ProxySettingsExtensionFields &fields) {
+	return fields.clientHelloType >= -1
+		&& fields.clientHelloType <= 5
+		&& IsProxySettingsBoolean(fields.slowMode)
+		&& IsProxySettingsBoolean(fields.preferIPv6)
+		&& fields.slowDelay >= 0
+		&& fields.slowJitter >= 0;
+}
+
+static_assert(kProxySettingsLegacyExtensionVersion == 1);
+static_assert(kProxySettingsExtensionVersion > kProxySettingsLegacyExtensionVersion);
+static_assert(kProxySettingsExtensionFieldCount == 5);
+
+} // namespace Core::details
