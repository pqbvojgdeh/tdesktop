+		bool preferIPv6) {
+	const auto firstV6 = qthelp::is_ipv6(first);
+	const auto secondV6 = qthelp::is_ipv6(second);
+	return (firstV6 == secondV6)
+		? false
+		: (firstV6 == preferIPv6);
