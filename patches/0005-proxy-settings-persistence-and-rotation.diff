+[[nodiscard]] qint32 ProxyCHelloTypeToInt(MTP::ProxyData::CHelloType settings) {
+	switch(settings) {
+	case MTP::ProxyData::CHelloType::RANDOM:  return -1;
+	case MTP::ProxyData::CHelloType::Firefox: return 0;
+	case MTP::ProxyData::CHelloType::Chrome:  return 1;
+	case MTP::ProxyData::CHelloType::Custom:  return 2;
+	case MTP::ProxyData::CHelloType::SafariMac: return 3;
+	case MTP::ProxyData::CHelloType::YandexGost: return 4;
+	case MTP::ProxyData::CHelloType::Chromium151: return 5;
+	}
+	return -1;
+}
+
+[[nodiscard]] MTP::ProxyData::CHelloType IntToProxyCHelloType(qint32 value) {
+	switch(value) {
+	case -1: return MTP::ProxyData::CHelloType::RANDOM;
+	case 0: return MTP::ProxyData::CHelloType::Firefox;
+	case 1: return MTP::ProxyData::CHelloType::Chrome;
+	case 2: return MTP::ProxyData::CHelloType::Custom;
+	case 3: return MTP::ProxyData::CHelloType::SafariMac;
+	case 4: return MTP::ProxyData::CHelloType::YandexGost;
+	case 5: return MTP::ProxyData::CHelloType::Chromium151;
+	}
+	return MTP::ProxyData::CHelloType::RANDOM;
+}
+
+// The policy header is compiled standalone by the tests and cannot see the
+// enum, so the serialized range it accepts is pinned to the enum here.
+// RANDOM is the last enumerator and serializes to -1, every other profile
+// serializes to its own underlying value, so the highest serialized profile
+// is always the one right before RANDOM. Adding a profile without widening
+// the range would make the new value fail validation and reset to RANDOM.
+static_assert(
+	int(MTP::ProxyData::CHelloType::RANDOM)
+		== details::kProxySettingsMaximumClientHelloType + 1,
+	"A ClientHello profile was added or reordered: update "
+	"kProxySettingsMaximumClientHelloType together with "
+	"ProxyCHelloTypeToInt and IntToProxyCHelloType.");
+
