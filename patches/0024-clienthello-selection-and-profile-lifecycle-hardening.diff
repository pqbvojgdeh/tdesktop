+[[nodiscard]] ProxyData::CHelloType StickyRandomClientHelloType() {
+	static const auto result = [] {
+		auto profiles = std::vector{
+			ProxyData::CHelloType::Firefox,
+			ProxyData::CHelloType::Chrome,
+			ProxyData::CHelloType::Custom,
+			ProxyData::CHelloType::Chromium150,
+		};
+		if constexpr (Platform::IsMac()) {
+			profiles.push_back(ProxyData::CHelloType::SafariMac);
+		}
+		if (QLocale::system().language() == QLocale::Russian) {
+			profiles.push_back(ProxyData::CHelloType::YandexGost);
+		}
+		Assert(!profiles.empty());
+		return profiles[QRandomGenerator::global()->bounded(
+			int(profiles.size()))];
+	}();
+	return result;
+}
