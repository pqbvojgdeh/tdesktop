+struct IpHealthKey {
+	QString host;
+	uint32 port = 0;
+	QString ip;
+
+	friend bool operator<(const IpHealthKey &a, const IpHealthKey &b) {
+		return std::tie(a.host, a.port, a.ip)
+			< std::tie(b.host, b.port, b.ip);
+	}
+};
+
+struct IpHealthEntry {
+	crl::time quarantineUntil = 0;
+	crl::time lastFailureAt = 0;
+	int failures = 0;
+};
+
+[[nodiscard]] bool UsesFakeTls(const ProxyData &proxy) {
+	if (proxy.type != ProxyData::Type::Mtproto) {
+		return false;
+	}
+	const auto secret = proxy.secretFromMtprotoPassword();
+	return secret.size() > 17 && secret.front() == bytes::type(0xEE);
+}
+
+[[nodiscard]] crl::time OneConnectionTimeout(const ProxyData &proxy) {
+	return ProxyData::globalSlowMode() && UsesFakeTls(proxy)
+		? kSlowOneConnectionTimeout
+		: kOneConnectionTimeout;
+}
+
+[[nodiscard]] std::mutex &IpHealthMutex() {
+	static const auto result = new std::mutex();
+	return *result;
+}
+
+[[nodiscard]] auto &IpHealthMap() {
+	static const auto result = new std::map<IpHealthKey, IpHealthEntry>();
+	return *result;
+}
+
+[[nodiscard]] IpHealthKey MakeIpHealthKey(
+		const QString &host,
+		uint32 port,
+		const QString &ip) {
+	return { host.toLower(), port, ip.toLower() };
+}
+
+void PruneIpHealth(crl::time now) {
+	auto &map = IpHealthMap();
+	for (auto i = map.begin(); i != map.end();) {
+		i = (!i->second.lastFailureAt
+			|| i->second.lastFailureAt + kIpHealthForgetAfter <= now)
+			? map.erase(i)
+			: std::next(i);
+	}
+}
+
+void TrimIpHealth() {
+	auto &map = IpHealthMap();
+	if (map.size() < kMaximumIpHealthEntries) {
+		return;
+	}
+	const auto oldest = std::min_element(
+		begin(map),
+		end(map),
+		[](const auto &a, const auto &b) {
+			return a.second.lastFailureAt < b.second.lastFailureAt;
+		});
+	if (oldest != end(map)) {
+		map.erase(oldest);
+	}
+}
+
+void MarkIpFailed(
+		const QString &host,
+		uint32 port,
+		const QString &ip) {
+	if (host.isEmpty() || !port || ip.isEmpty()) {
+		return;
+	}
+	const auto now = crl::now();
+	const auto lock = std::lock_guard(IpHealthMutex());
+	PruneIpHealth(now);
+	const auto key = MakeIpHealthKey(host, port, ip);
+	if (!IpHealthMap().contains(key)) {
+		TrimIpHealth();
+	}
+	auto &entry = IpHealthMap()[key];
+	if (!entry.lastFailureAt
+		|| entry.lastFailureAt + kIpHealthForgetAfter <= now) {
+		entry.failures = 0;
+	}
+	entry.failures = std::min(entry.failures + 1, 6);
+	const auto multiplier = 1 << std::min(entry.failures - 1, 5);
+	const auto duration = std::min(
+		kIpQuarantineBase * multiplier,
+		kIpQuarantineMaximum);
+	entry.lastFailureAt = now;
+	entry.quarantineUntil = now + duration;
+}
+
+void ClearIpHealth(
+		const QString &host,
+		uint32 port,
+		const QString &ip) {
+	if (host.isEmpty() || !port || ip.isEmpty()) {
+		return;
+	}
+	const auto lock = std::lock_guard(IpHealthMutex());
+	IpHealthMap().erase(MakeIpHealthKey(host, port, ip));
+}
+
+[[nodiscard]] int FindNextResolvedIpIndex(
+		const ProxyData &proxy,
+		int afterIndex) {
+	const auto now = crl::now();
+	const auto lock = std::lock_guard(IpHealthMutex());
+	PruneIpHealth(now);
+	auto fallback = -1;
+	auto fallbackUntil = crl::time(0);
+	for (auto index = afterIndex + 1;
+		index < int(proxy.resolvedIPs.size());
+		++index) {
+		const auto i = IpHealthMap().find(MakeIpHealthKey(
+			proxy.host,
+			proxy.port,
+			proxy.resolvedIPs[index]));
+		if (i == end(IpHealthMap()) || i->second.quarantineUntil <= now) {
+			return index;
+		}
+		if (fallback < 0 || i->second.quarantineUntil < fallbackUntil) {
+			fallback = index;
+			fallbackUntil = i->second.quarantineUntil;
+		}
+	}
+	return fallback;
+}
 
