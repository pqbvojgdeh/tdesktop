+[[nodiscard]] QString FormatProxyEndpoint(const QString &host, uint32 port) {
+	return qthelp::is_ipv6(host)
+		? u"[%1]:%2"_q.arg(host).arg(port)
+		: u"%1:%2"_q.arg(host).arg(port);
+}
+
+[[nodiscard]] QString ClientHelloName(ProxyData::CHelloType type) {
+	switch (type) {
+	case ProxyData::CHelloType::Chrome:
+		return tr::lng_proxy_chrome_profile(tr::now);
+	case ProxyData::CHelloType::Custom:
+		return tr::lng_proxy_firefox_permuted_profile(tr::now);
+	case ProxyData::CHelloType::SafariMac:
+		return tr::lng_proxy_safari_profile(tr::now);
+	case ProxyData::CHelloType::YandexGost:
+		return tr::lng_proxy_yandex_gost_profile(tr::now);
+	case ProxyData::CHelloType::Chromium150:
+		return tr::lng_proxy_chromium_profile(tr::now);
+	case ProxyData::CHelloType::RANDOM:
+		return tr::lng_proxy_random_profile(tr::now);
+	case ProxyData::CHelloType::Firefox:
+	default:
+		return tr::lng_proxy_firefox_profile(tr::now);
+	}
+}
+
+[[nodiscard]] QString ClientHelloStatusText(const ProxyData &proxy) {
+	const auto status = ProxyData::globalCHelloStatus(proxy);
+	if (!status.used) {
+		return tr::lng_proxy_ch_status_unused(tr::now);
+	}
+	const auto profile = ClientHelloName(status.actual);
+	auto result = [&] {
+		if (status.random && status.chromium150) {
+			return status.resumed
+				? tr::lng_proxy_ch_status_random_resumed(
+					tr::now,
+					lt_profile,
+					profile)
+				: tr::lng_proxy_ch_status_random_fresh(
+					tr::now,
+					lt_profile,
+					profile);
+		} else if (status.random) {
+			return tr::lng_proxy_ch_status_random(
+				tr::now,
+				lt_profile,
+				profile);
+		} else if (status.chromium150) {
+			return status.resumed
+				? tr::lng_proxy_ch_status_resumed(
+					tr::now,
+					lt_profile,
+					profile)
+				: tr::lng_proxy_ch_status_fresh(
+					tr::now,
+					lt_profile,
+					profile);
 		}
+		return profile;
+	}();
+	if (!status.host.isEmpty()) {
+		const auto actual = FormatProxyEndpoint(status.host, status.port);
+		const auto original = FormatProxyEndpoint(proxy.host, proxy.port);
+		const auto resolved = proxy.tryCustomResolve()
+			&& (status.host.compare(proxy.host, Qt::CaseInsensitive) != 0);
+		result += u"\n"_q + (resolved
+			? original + u" → "_q + actual
+			: actual);
+	}
+	if (status.chromium150 && status.ttlMinutes > 0) {
+		result += status.resumed
+			? tr::lng_proxy_ch_status_refresh(
+				tr::now,
+				lt_count,
+				status.ttlLeftMinutes)
+			: tr::lng_proxy_ch_status_resume_window(
+				tr::now,
+				lt_count,
+				status.ttlLeftMinutes);
 	}
 	return result;
 }
 
+[[nodiscard]] QString SlowModeSummary(const Core::SettingsProxy &settings) {
+	return settings.proxySlowMode()
+		? tr::lng_proxy_slow_range(
+			tr::now,
+			lt_minimum,
+			QString::number(settings.proxySlowDelay()),
+			lt_maximum,
+			QString::number(
+				settings.proxySlowDelay() + settings.proxySlowJitter()))
+		: tr::lng_proxy_slow_disabled(tr::now);
+}
