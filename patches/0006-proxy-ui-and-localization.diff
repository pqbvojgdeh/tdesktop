+bool ProxiesBoxController::cancelBatchCheck(Item &item) {
+	item.checker = nullptr;
+	++item.checkGeneration;
+	if (!item.batchCheck) {
+		return false;
+	}
+	item.batchCheck = false;
+	return _batchChecksLeft > 0 && --_batchChecksLeft == 0;
+}
+
+void ProxiesBoxController::checkFinished(
+		int id,
+		ItemState state,
+		int ping,
+		bool batch,
+		uint64 generation) {
+	const auto item = ranges::find(
+		_list,
+		id,
+		[](const Item &item) { return item.id; });
+	if (item == end(_list)
+		|| item->state != ItemState::Checking
+		|| item->batchCheck != batch
+		|| item->checkGeneration != generation) {
+		return;
+	}
+	item->checker = nullptr;
+	item->state = state;
+	item->ping = ping;
+	item->checkedAt = QTime::currentTime().toString(u"HH:mm:ss"_q);
+	item->batchCheck = false;
+	updateView(*item);
+	if (batch && _batchChecksLeft > 0 && --_batchChecksLeft == 0) {
+		requestFinishChecksBatch();
+	}
+}
+
+void ProxiesBoxController::refreshAllChecks() {
+	if (!_settings.isEnabled() || _checksRunning.current()) {
+		return;
+	}
+	auto ids = std::vector<int>();
+	ids.reserve(_list.size());
+	for (const auto &item : _list) {
+		if (!item.deleted) {
+			ids.push_back(item.id);
+		}
+	}
+	if (ids.empty()) {
+		return;
+	}
+	// Keep the iteration stable even if a check completes synchronously.
+	_batchChecksLeft = int(ids.size());
+	_batchSetupInProgress = true;
+	_batchFinishPending = false;
+	_checksRunning = true;
+	for (const auto id : ids) {
+		const auto item = ranges::find(
+			_list,
+			id,
+			[](const Item &item) { return item.id; });
+		if (item != end(_list) && !item->deleted) {
+			refreshChecker(*item, true);
+		} else if (_batchChecksLeft > 0 && --_batchChecksLeft == 0) {
+			_batchFinishPending = true;
+		}
+	}
+	_batchSetupInProgress = false;
+	if (_batchFinishPending || !_batchChecksLeft) {
+		requestFinishChecksBatch();
+	}
+}
+
+void ProxiesBoxController::cancelAllChecks() {
+	for (auto &item : _list) {
+		item.checker = nullptr;
+		++item.checkGeneration;
+		item.batchCheck = false;
+		item.state = ItemState::Inactive;
+		item.ping = 0;
+		item.checkedAt = QString();
+		updateView(item);
+	}
+	_batchChecksLeft = 0;
+	_batchSetupInProgress = false;
+	_batchFinishPending = false;
+	_checksRunning = false;
+}
+
+void ProxiesBoxController::requestFinishChecksBatch() {
+	if (_batchChecksLeft != 0) {
+		return;
+	} else if (_batchSetupInProgress) {
+		_batchFinishPending = true;
+		return;
+	}
+	finishChecksBatch();
+}
+
+void ProxiesBoxController::finishChecksBatch() {
+	if (!_checksRunning.current()) {
+		return;
+	}
+	_batchChecksLeft = 0;
+	_batchFinishPending = false;
+	_checksRunning = false;
+}
+
+int ProxiesBoxController::compareEndpoints(
+		const Item &a,
+		const Item &b) const {
+	static const auto collator = [] {
+		auto result = QCollator(QLocale::c());
+		result.setCaseSensitivity(Qt::CaseInsensitive);
+		result.setNumericMode(true);
+		return result;
+	}();
+	const auto host = collator.compare(a.data.host, b.data.host);
+	if (host != 0) {
+		return host;
+	} else if (a.data.port != b.data.port) {
+		return (a.data.port < b.data.port) ? -1 : 1;
+	} else if (a.data.type != b.data.type) {
+		return (int(a.data.type) < int(b.data.type)) ? -1 : 1;
 	}
+	return (a.id == b.id) ? 0 : (a.id < b.id ? -1 : 1);
+}
+
+void ProxiesBoxController::sortListByEndpoint() {
+	std::stable_sort(begin(_list), end(_list), [=](const Item &a, const Item &b) {
+		if (a.deleted != b.deleted) {
+			return !a.deleted;
+		}
+		return compareEndpoints(a, b) < 0;
+	});
 }
 
